# ==============================================================================
# TERRAFORM VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to terraform.tfvars and fill in your values.
# DO NOT commit terraform.tfvars to Git.
# ==============================================================================

# Database Configuration
# RDS master passwords can use printable ASCII characters except '/', '@',
# double quote, and spaces.
db_password = "replace-with-a-valid-rds-password"

# Strapi Secrets
# Generate unique values for each deployment:
# openssl rand -base64 32
app_keys            = "key1,key2,key3,key4"
jwt_secret          = "replace-with-jwt-secret"
admin_jwt_secret    = "replace-with-admin-jwt-secret"
api_token_salt      = "replace-with-api-token-salt"
transfer_token_salt = "replace-with-transfer-token-salt"

# Deployment Configuration
# Set true only if CodeDeploy is available for this AWS account.
enable_codedeploy = false
